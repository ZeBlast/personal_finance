{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window. The shell plugin is used only from Rust and is not exposed to the page.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://127.0.0.1:*/*" },
        { "url": "https://dashboard.plaid.com/*" },
        { "url": "https://github.com/ZeBlast/personal_finance/*" }
      ]
    },
    "updater:default",
    "process:allow-restart",
    "notification:default"
  ]
}
