# Used when running the backend directly in development (`npm run dev:backend`).
# In the installed app, Tauri sets these automatically for the sidecar; do not copy secrets into the repo.

# Port the backend listens on (127.0.0.1 only)
PF_PORT=47831
# Where the SQLite database lives (defaults to a folder under %APPDATA%)
PF_DATA_DIR=./data
# Shared secret the UI must send with every API call. Any long random string in development.
PF_TOKEN=dev-token
# Lets the Vite dev server (hot reload) talk to the backend. Development only; the installed app
# never sets this.
PF_ALLOW_DEV_ORIGIN=1

# Added in later phases (Plaid Sandbox first):
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# PF_ENCRYPTION_KEY=   # 32-byte key (hex) for encrypting Plaid access tokens
